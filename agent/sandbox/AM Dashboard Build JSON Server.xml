  <Step enable="True" id="89" name="# (comment)">
    <Text>Hours: PIC only (CommandDay+Night) via FlightId — avoid double-count with copilot; fallback HH:MM / FlightTimeDecimal</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~sql = ExecuteSQL ( "SELECT SUM ( CommandDay + CommandNight )
FROM AM_FlightPersonnel
WHERE Deleted = 0
 AND FlightId = ?
 AND ( CommandDay > 0 OR CommandNight > 0 )" ; "" ; "" ; AM_Imported_Flights::FlightId ) ;
	~pers = GetAsNumber ( Substitute ( ~sql ; "." ; "," ) ) ;
	~persOk = If ( IsEmpty ( ~pers ) or ~pers ≤ 0 or ~pers > 24 ; "" ; Round ( ~pers ; 2 ) ) ;
	~t = Trim ( AM_Imported_Flights::FlightTimeText ) ;
	~c = Position ( ~t ; ":" ; 1 ; 1 ) ;
	~th = If ( ~c ; GetAsNumber ( Left ( ~t ; ~c - 1 ) ) ; -1 ) ;
	~tm = If ( ~c ; GetAsNumber ( Middle ( ~t ; ~c + 1 ; 2 ) ) ; -1 ) ;
	~fromText = If ( ~c and Length ( ~t ) ≤ 8 and ~th ≥ 0 and ~th < 24 and ~tm ≥ 0 and ~tm < 60 ; Round ( ~th + ~tm / 60 ; 2 ) ; "" ) ;
	~dec = GetAsNumber ( AM_Imported_Flights::FlightTimeDecimal ) ;
	~decOk = If ( IsEmpty ( ~dec ) or ~dec ≤ 0 or ~dec > 24 ; "" ; ~dec )
] ;
Case (
	not IsEmpty ( ~persOk ) ; ~persOk ;
	not IsEmpty ( ~fromText ) ; ~fromText ;
	not IsEmpty ( ~decOk ) ; ~decOk ;
	0
)
)]]></Calculation>
    </Value>
