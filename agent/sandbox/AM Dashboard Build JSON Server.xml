  <Step enable="True" id="89" name="# (comment)">
    <Text>STOCKHOLM: DutyType Dygn(24hr) → STO 24h, else STO Day (also remaps STO ####)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~raw = Trim ( AM_Imported_Flights::BaseName ) ;
	~duty = Trim ( AM_Imported_Flights::DutyType ) ;
	~isSto = ~raw = "Stockholm"
		or Left ( ~raw ; 4 ) = "STO "
] ;
	If ( ~isSto ;
		If (
			PatternCount ( ~duty ; "Dygn" ) > 0
			or PatternCount ( ~duty ; "24hr" ) > 0
			or PatternCount ( Lower ( ~duty ) ; "24h" ) > 0 ;
			"STO 24h" ;
			"STO Day"
		) ;
		~raw
	)
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$base</Name>
  </Step>
