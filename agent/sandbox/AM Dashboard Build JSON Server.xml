  <Step enable="True" id="89" name="# (comment)">
    <Text>IFR/NVG/Night/Landings: flight fields first; else PIC from AM_FlightPersonnel (fixes empty 2025 imports)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~fIfr = GetAsNumber ( AM_Imported_Flights::IFRTimeDecimal ) ;
	~fNvg = GetAsNumber ( AM_Imported_Flights::NVGTimeDecimal ) ;
	~fNight = GetAsNumber ( AM_Imported_Flights::NightTimeDecimal ) ;
	~fLdg = GetAsNumber ( AM_Imported_Flights::LandingsDay ) + GetAsNumber ( AM_Imported_Flights::LandingsNight ) ;
	~need = ( IsEmpty ( ~fIfr ) or ~fIfr ≤ 0 )
		or ( IsEmpty ( ~fNvg ) or ~fNvg ≤ 0 )
		or ( IsEmpty ( ~fNight ) or ~fNight ≤ 0 )
		or ( IsEmpty ( ~fLdg ) or ~fLdg ≤ 0 ) ;
	~sql = If ( ~need ;
		ExecuteSQL ( "SELECT
 SUM ( LandingsDay + LandingsNight ),
 SUM ( IFRHours ),
 SUM ( CommandNight ),
 SUM ( NVGHours )
FROM AM_FlightPersonnel
WHERE Deleted = 0
 AND FlightId = ?
 AND ( CommandDay > 0 OR CommandNight > 0 )" ; "|" ; "" ; AM_Imported_Flights::FlightId ) ;
		""
	) ;
	~parts = If ( IsEmpty ( ~sql ) or ~sql = "?" ; "" ; Substitute ( ~sql ; "|" ; "¶" ) ) ;
	~pLdg = GetAsNumber ( Substitute ( GetValue ( ~parts ; 1 ) ; "." ; "," ) ) ;
	~pIfr = GetAsNumber ( Substitute ( GetValue ( ~parts ; 2 ) ; "." ; "," ) ) ;
	~pNight = GetAsNumber ( Substitute ( GetValue ( ~parts ; 3 ) ; "." ; "," ) ) ;
	~pNvg = GetAsNumber ( Substitute ( GetValue ( ~parts ; 4 ) ; "." ; "," ) )
] ;
JSONSetElement ( "{}" ;
	[ "ifr" ; If ( ~fIfr > 0 and ~fIfr ≤ 24 ; ~fIfr ; If ( ~pIfr > 0 and ~pIfr ≤ 24 ; Round ( ~pIfr ; 2 ) ; 0 ) ) ; JSONNumber ] ;
	[ "nvg" ; If ( ~fNvg > 0 and ~fNvg ≤ 24 ; ~fNvg ; If ( ~pNvg > 0 and ~pNvg ≤ 24 ; Round ( ~pNvg ; 2 ) ; 0 ) ) ; JSONNumber ] ;
	[ "night" ; If ( ~fNight > 0 and ~fNight ≤ 24 ; ~fNight ; If ( ~pNight > 0 and ~pNight ≤ 24 ; Round ( ~pNight ; 2 ) ; 0 ) ) ; JSONNumber ] ;
	[ "landings" ; If ( ~fLdg > 0 ; ~fLdg ; If ( ~pLdg > 0 ; ~pLdg ; 0 ) ) ; JSONNumber ]
)
)]]></Calculation>
    </Value>
