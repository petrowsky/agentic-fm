  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["SELECT
 AM_Imported_Flights.BaseName,
 AM_FlightPersonnel.PilotName,
 SUM ( AM_FlightPersonnel.MissionCount ),
 SUM ( AM_FlightPersonnel.CommandHours ),
 SUM ( AM_FlightPersonnel.CopilotHours )
FROM AM_FlightPersonnel
INNER JOIN AM_Imported_Flights ON AM_FlightPersonnel.FlightId = AM_Imported_Flights.FlightId
WHERE AM_FlightPersonnel.Deleted = 0
 AND AM_Imported_Flights.FlightDate >= ?
 AND ( AM_FlightPersonnel.CommandDay > 0
	OR AM_FlightPersonnel.CommandNight > 0
	OR AM_FlightPersonnel.CoPilotDay > 0
	OR AM_FlightPersonnel.CopilotNight > 0 )
GROUP BY AM_Imported_Flights.BaseName, AM_FlightPersonnel.PilotName
HAVING SUM ( AM_FlightPersonnel.CommandHours ) > 0
 OR SUM ( AM_FlightPersonnel.CopilotHours ) > 0
ORDER BY AM_Imported_Flights.BaseName, SUM ( AM_FlightPersonnel.MissionCount ) DESC"]]></Calculation>
