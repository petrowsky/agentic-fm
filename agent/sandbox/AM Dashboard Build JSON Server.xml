or PatternCount ( $base ; "Tech" ) > 0
or PatternCount ( $base ; "Touring" ) > 0
or PatternCount ( $base ; "Frösön" ) > 0
or PatternCount ( $base ; "Frosön" ) > 0
or PatternCount ( $base ; "ON LEAVE" ) > 0
or PatternCount ( $base ; "Training Base" ) > 0
