  <Step enable="True" id="89" name="# (comment)">
    <Text>MISSIONS: STO Day/24h = Legs from JsonFlightRaw; other bases = MissionCount (default 1)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~stored = GetAsNumber ( AM_Imported_Flights::MissionCount ) ;
	~isSto = Left ( $base ; 4 ) = "STO "
		or $base = "Stockholm"
		or PatternCount ( $base ; "Stockholm" ) > 0 ;
	~legs = If (
		~isSto
		and not IsEmpty ( AM_Imported_Flights::JsonFlightRaw )
		and JSONGetElementType ( AM_Imported_Flights::JsonFlightRaw ; "Legs" ) = JSONArray ;
		ValueCount ( JSONListKeys ( AM_Imported_Flights::JsonFlightRaw ; "Legs" ) ) ;
		""
	) ;
	~legsN = GetAsNumber ( ~legs )
] ;
Case (
	~isSto and ~legsN > 0 ; ~legsN ;
	~stored > 0 ; ~stored ;
	1
)
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$missions</Name>
  </Step>
