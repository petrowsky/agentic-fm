  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["SELECT
 CASE
  WHEN AM_Imported_Flights.BaseName = 'Stockholm'
    OR AM_Imported_Flights.BaseName LIKE 'STO %'
  THEN CASE
    WHEN AM_Imported_Flights.DutyType LIKE '%Dygn%'
      OR AM_Imported_Flights.DutyType LIKE '%24hr%'
      OR AM_Imported_Flights.DutyType LIKE '%24h%'
    THEN 'STO 24h'
    ELSE 'STO Day'
  END
  ELSE AM_Imported_Flights.BaseName
 END,
 COALESCE ( AM_Personnel.FullName, 'Unknown' ),
 SUM ( AM_Imported_Flights.MissionCount ),
 SUM ( AM_FlightPersonnel.CommandDay + AM_FlightPersonnel.CommandNight )
FROM AM_FlightPersonnel
INNER JOIN AM_Imported_Flights ON AM_FlightPersonnel.FlightId = AM_Imported_Flights.FlightId
LEFT JOIN AM_Personnel ON AM_FlightPersonnel.PersonnelID = AM_Personnel.PersonnelID
WHERE AM_FlightPersonnel.Deleted = 0
 AND AM_Imported_Flights.FlightDate >= ?/*ENDDATE*/
 AND ( AM_FlightPersonnel.CommandDay > 0
	OR AM_FlightPersonnel.CommandNight > 0 )
GROUP BY
 CASE
  WHEN AM_Imported_Flights.BaseName = 'Stockholm'
    OR AM_Imported_Flights.BaseName LIKE 'STO %'
  THEN CASE
    WHEN AM_Imported_Flights.DutyType LIKE '%Dygn%'
      OR AM_Imported_Flights.DutyType LIKE '%24hr%'
      OR AM_Imported_Flights.DutyType LIKE '%24h%'
    THEN 'STO 24h'
    ELSE 'STO Day'
  END
  ELSE AM_Imported_Flights.BaseName
 END,
 COALESCE ( AM_Personnel.FullName, 'Unknown' )
HAVING SUM ( AM_FlightPersonnel.CommandDay + AM_FlightPersonnel.CommandNight ) > 0
ORDER BY 1, SUM ( AM_Imported_Flights.MissionCount ) DESC"]]></Calculation>
