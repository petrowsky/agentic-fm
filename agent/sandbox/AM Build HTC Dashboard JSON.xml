  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["SELECT
 AM_FlightPersonnel.PersonnelID,
 SUM ( AM_FlightPersonnel.CrewmanD ),
 SUM ( AM_FlightPersonnel.CrewmanN ),
 SUM ( AM_FlightPersonnel.MissionCount ),
 SUM ( AM_FlightPersonnel.IFRHours ),
 SUM ( AM_FlightPersonnel.NVGHours )
FROM AM_FlightPersonnel
INNER JOIN AM_Imported_Flights ON AM_FlightPersonnel.FlightId = AM_Imported_Flights.FlightId
WHERE AM_FlightPersonnel.Deleted = 0
 AND ( AM_FlightPersonnel.CrewmanD > 0 OR AM_FlightPersonnel.CrewmanN > 0 )
 AND AM_FlightPersonnel.CommandDay + AM_FlightPersonnel.CommandNight + AM_FlightPersonnel.CoPilotDay + AM_FlightPersonnel.CopilotNight = 0
 AND AM_Imported_Flights.FlightDate >= ?
GROUP BY AM_FlightPersonnel.PersonnelID
HAVING SUM ( AM_FlightPersonnel.CrewmanD + AM_FlightPersonnel.CrewmanN ) > 0
ORDER BY SUM ( AM_FlightPersonnel.MissionCount ) DESC"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$sql</Name>
