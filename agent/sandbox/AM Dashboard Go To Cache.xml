<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Go to AM_Dashboard_Cache record by CacheName (script parameter). Exact find — never Next/Previous.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>PARAM: Cache key text, e.g. OPS_7D | OPS_30D | OPS_2026 | PilotStats_7D | HTCStats_7D | HELI_TYPE_7D</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Trim ( Get ( ScriptParameter ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$cacheName</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>LEGACY ALIASES: old keys without period suffix map to _7D</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$cacheName = "PilotStats"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["PilotStats_7D"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$cacheName</Name>
  </Step>
  <Step enable="True" id="125" name="Else If">
    <Restore state="False"/>
    <Calculation><![CDATA[$cacheName = "HTCStats"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["HTCStats_7D"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$cacheName</Name>
  </Step>
  <Step enable="True" id="125" name="Else If">
    <Restore state="False"/>
    <Calculation><![CDATA[$cacheName = "HELI_TYPE"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["HELI_TYPE_7D"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$cacheName</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $cacheName )]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["AM Dashboard"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Go To Cache: missing script parameter."]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
    </Buttons>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; [ "ok" ; 0 ; JSONNumber ] ; [ "error" ; "Missing cache name" ; JSONString ] )]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="304" name="AM_Dashboard_Cache"></Layout>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["==" & $cacheName]]></Calculation>
    <Field table="AM_Dashboard_Cache" id="2" name="CacheName"/>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["AM Dashboard"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Cache not found: " & $cacheName & ¶ &
"Expected keys: OPS_7D / OPS_30D / OPS_" & Year ( Get ( CurrentDate ) ) & " / PilotStats_7D / HTCStats_7D / HELI_TYPE_7D." & ¶ &
"Run AM Statistics PSOS so period caches exist." & ¶ &
"Also halt Show stat loop (Esc) — it advances records with Next and breaks period buttons."]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
    </Buttons>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[JSONSetElement (
	"{}" ;
	[ "ok" ; 0 ; JSONNumber ] ;
	[ "error" ; "Cache not found: " & $cacheName ; JSONString ] ;
	[ "cacheName" ; $cacheName ; JSONString ]
)]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="16" name="Go to Record/Request/Page">
    <RowPageLocation value="First"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[AM_Dashboard_Cache::CasheName ≠ $cacheName]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["AM Dashboard"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Go To Cache landed on wrong record." & ¶ &
"Wanted: " & $cacheName & ¶ &
"Got: " & AM_Dashboard_Cache::CasheName]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
    </Buttons>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="80" name="Refresh Window">
    <Option state="False"/>
    <FlushSQLData state="False"/>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[JSONSetElement (
	"{}" ;
	[ "ok" ; 1 ; JSONNumber ] ;
	[ "cacheName" ; $cacheName ; JSONString ]
)]]></Calculation>
  </Step>
</fmxmlsnippet>
