<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="139" name="Convert File">
    <NoInteract state="False"/>
    <Option state="False"/>
    <SkipIndexes state="True"/>
    <VerifySSLCertificates state="True"/>
    <DataSourceType value="File"/>
    <Profile FieldDelimiter="&#9;" IsPredefined="-1" FieldNameRow="-1" DataType="    "/>
    <UniversalPathList>$path</UniversalPathList>
    <ImportOptions TargetTableName="Table" CharacterSet="Macintosh" KeepOriginalData="False" PreserveContainer="False" MatchFieldNames="False" AutoEnter="False" SplitRepetitions="False" method="Add"/>
  </Step>
</fmxmlsnippet>
<!-- NoInteract state: "True" suppresses dialogs (HR: With dialog: Off). "False" shows dialogs (HR: With dialog: On). Inverted in HR. -->
<!-- Option state: "False" in all known examples. HR always shows "Open File". -->
<!-- SkipIndexes state: "True" skips index creation (HR: Skip Indexes shown). "False" creates indexes (HR: Skip Indexes omitted). -->
<!-- VerifySSLCertificates state: "True" verifies SSL (HR: Verify SSL Certificates shown). "False" skips (HR: omitted). -->
<!-- DataSourceType value: "File" (file path) | "XMLSource" (XML with stylesheet). -->
<!-- UniversalPathList: source file path. Supports $variable, file:, filemac:, filewin:, fmnet: formats. If omitted, Open File dialog is shown. -->
<!-- Profile element varies by DataSourceType and source method: -->
<!--   File type: <Profile FieldDelimiter="&#9;" IsPredefined="-1" FieldNameRow="-1" DataType="    "/> -->
<!--   XMLSource: the File attributes stay, DataType="XML ", plus XMLType (XMLFile | XMLHttp | XMLCalculation) and XSLType (XSLFile | XSLHttp | XSLCalculation | NoXSL), mixed freely. -->
<!--   XMLSource HTTP: <XMLHttp> / <XSLHttp> children containing URLs. -->
<!--   XMLSource File: <XMLFile> / <XSLFile> children containing paths, one per line. -->
<!--   XMLSource Calc: <XMLCalc><Calculation/></XMLCalc> / <XSLCalc><Calculation/></XSLCalc> children. An XML calculation is also written as a step-level <Calculation> after the Profile; FileMaker keeps that copy and drops an <XMLCalc> pasted without it. -->
<!--   Example (FileMaker Pro 26.0.3): <Profile XSLType="NoXSL" XMLType="XMLCalculation" FieldDelimiter="&#9;" IsPredefined="-1" FieldNameRow="-1" DataType="XML "><XMLCalc><Calculation><![CDATA[$url]]></Calculation></XMLCalc></Profile><Calculation><![CDATA[$url]]></Calculation> -->
<!-- UniversalPathList: absent with an XML source and with no path. -->
<!-- ImportOptions: dialog-configured element with TargetTableName, CharacterSet, KeepOriginalData, PreserveContainer, MatchFieldNames, AutoEnter, SplitRepetitions, method attributes; AddRemainingRecords with an update method. -->
<!-- FileMaker Pro only; not supported on Go, WebDirect, Server, Cloud, Data API, or CWP. -->
<!-- See https://help.claris.com/en/pro-help/content/convert-file.html -->
